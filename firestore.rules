rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function librarian() {
      return signedIn() && request.auth.token.librarian == true;
    }
    function own(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /memberNumbers/{libraryNumber} {
      // A signed-in learner may reserve a number only for their own UID.
      // The paired profile must be created atomically in the same transaction.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && libraryNumber.matches('AMG-[0-9]{6}');
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Learner self-registration is restricted to a pending profile paired
      // atomically with its matching member-number reservation.
      allow create: if own(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'gender', 'school', 'studyLevel', 'eduLevel',
          'guardianName', 'guardianRelation', 'guardianPhone', 'libraryNumber',
          'role', 'isApproved', 'membershipStatus', 'photoURL', 'starredBookIds',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'gender', 'school', 'studyLevel', 'eduLevel',
          'guardianName', 'guardianRelation', 'guardianPhone', 'libraryNumber',
          'role', 'isApproved', 'membershipStatus', 'photoURL', 'starredBookIds',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'learner'
        && request.resource.data.isApproved == false
        && request.resource.data.membershipStatus == 'Pending'
        && request.resource.data.libraryNumber.matches('AMG-[0-9]{6}')
        && getAfter(/databases/$(database)/documents/memberNumbers/$(request.resource.data.libraryNumber)).data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.fullName is string
        && request.resource.data.guardianPhone is string
        && request.resource.data.starredBookIds is list;
      allow read: if own(uid) || librarian();
      // Learners can only update their own safe profile fields, never role,
      // approval status, library number, guardian data or account identity.
      allow update: if (librarian()
        && resource.data.role == 'learner'
        && resource.data.isApproved == false
        && resource.data.membershipStatus == 'Pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isApproved', 'membershipStatus', 'decisionAt', 'decisionBy',
          'approvedAt', 'deniedAt', 'updatedAt'
        ])
        && request.resource.data.isApproved == (request.resource.data.membershipStatus == 'Approved')
        && request.resource.data.membershipStatus in ['Approved', 'Denied']
        && request.resource.data.decisionBy == request.auth.uid
        && request.resource.data.decisionAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.membershipStatus == 'Approved'
          && request.resource.data.approvedAt == request.time)
          || (request.resource.data.membershipStatus == 'Denied'
          && request.resource.data.deniedAt == request.time)))
        || (own(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['photoURL', 'starredBookIds', 'updatedAt'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.isApproved == resource.data.isApproved);
      allow delete: if librarian();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if librarian();
    }

    match /borrowRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.bookId is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true
        && get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.available > 0;
      allow read: if librarian()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if librarian();
    }

    match /loans/{loanId} {
      allow read: if librarian()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if librarian();
    }

    match /attendance/{attendanceId} {
      allow read: if librarian();
      allow create: if librarian()
        && request.resource.data.keys().hasOnly([
          'uid', 'memberName', 'libraryNumber', 'checkInAt', 'checkOutAt',
          'status', 'recordedBy'
        ])
        && request.resource.data.uid is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.role == 'learner'
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.isApproved == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.libraryNumber == request.resource.data.libraryNumber
        && request.resource.data.checkInAt == request.time
        && request.resource.data.checkOutAt == null
        && request.resource.data.status == 'In library'
        && request.resource.data.recordedBy == request.auth.uid;
      allow update: if librarian()
        && resource.data.status == 'In library'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'checkOutAt', 'status', 'checkedOutBy'
        ])
        && request.resource.data.status == 'Checked out'
        && request.resource.data.checkOutAt == request.time
        && request.resource.data.checkedOutBy == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.recordedBy == resource.data.recordedBy;
      allow delete: if false;
    }

    match /bookCopies/{copyId} {
      allow read: if librarian();
      allow create, update, delete: if false;
    }

    match /memberPresence/{uid} {
      allow read: if librarian() || own(uid);
      allow create: if librarian()
        && request.resource.data.keys().hasOnly(['uid', 'attendanceId', 'status', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'In library'
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceId)).data.status == 'In library';
      allow update: if librarian()
        && resource.data.uid == uid
        && resource.data.status == 'In library'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'Checked out'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if librarian();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if librarian();
    }

    match /ebooks/{ebookId} {
      allow read: if signedIn();
      allow create, update, delete: if librarian();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if librarian();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
